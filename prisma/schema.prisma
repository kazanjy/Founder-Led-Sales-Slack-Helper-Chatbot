// ============================================
// COACHING HISTORY
// ============================================

model CoachingSession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title        String // e.g. "Weekly Coaching — Mar 3"
  sessionDate  DateTime // Date of the coaching session
  notes        String   @db.Text // Notes stored as markdown
  transcript   String?  @db.Text // Optional pasted call transcript
  recordingUrl String? // Optional link to meeting recording

  // Auto-generated synthesis — same prompt as the "Synthesize
  // Takeaways" CTA, regenerated server-side on every save so the
  // founder always has a fresh "what we discussed / agreed / will do
  // next" rollup without clicking. Null until the first save (or
  // until the synthesis job finishes for in-flight saves).
  synthesis    String?   @db.Text
  synthesisAt  DateTime?

  // Implicit goal tracking — candidate goal/task updates inferred from
  // the session's notes + transcript by the post-save extraction job.
  // Shape: { version, extractedAt, candidates: OutcomeCandidate[] }
  // (see lib/coaching/extract-outcomes.ts). Candidates persist here —
  // NOT in memory — so the review moment survives navigation and can
  // surface later (chip on the session, agent tools, Slack). Nothing
  // in this blob touches real goals/tasks until the founder accepts
  // it through the review panel's commit endpoint.
  outcomeCandidates   Json?
  outcomeCandidatesAt DateTime?
  // Stamped when the founder completes a review (accept/reject) pass.
  outcomesReviewedAt  DateTime?

  // Session lifecycle
  sessionStatus String  @default("new") // "new" | "in_progress" | "locked"
  maturityStage String? // Snapshot of sales maturity stage at session creation

  /// "standard" | "ad_hoc".
  ///
  /// An ad-hoc session is a real coaching session in every respect —
  /// it appears in history, gets a synthesis, extracts goals and tasks
  /// — EXCEPT that it is invisible to metrics. No entries are seeded
  /// for it, and it is skipped when resolving the previous value for a
  /// delta and when building the sparkline series, so a one-off
  /// conversation can't distort the measurement cadence.
  ///
  /// A kind rather than a `recordMetrics` boolean because it names the
  /// intent rather than the mechanism, and leaves room for other kinds
  /// later without another column.
  sessionKind String @default("standard")

  // Relations to coaching framework models
  goals         CoachingGoal[]
  metricEntries CoachingMetricEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, sessionDate(sort: Desc)])
  @@index([sessionKind])
  @@map("coaching_sessions")
}

