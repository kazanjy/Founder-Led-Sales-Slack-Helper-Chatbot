// ============================================
// DEALS
// ============================================

model Deal {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String // "Visana - Enterprise Deal"
  companyName String // "Visana Health"
  companyUrl  String? // for PDL company enrichment

  stage  String @default("prospecting") // "prospecting" | "discovery" | "demo" | "proposal" | "negotiation" | "closing" | "won" | "lost"
  status String @default("active") // "active" | "stalled" | "closed_won" | "closed_lost" | "potential" | "dismissed"

  // Provenance for auto-created deals. null = user-created.
  // "recorder" = spawned by the hourly call-recorder scanner.
  // "calendar" = spawned by the daily pre-call research cron.
  source String?

  // Forward-looking sell-by date the rep sets when forecasting.
  projectedCloseDate DateTime?
  // Actual date the deal closed (won or lost). Set when the user
  // flips status to closed_won / closed_lost.
  closeDate          DateTime?
  // Free-text reason captured when a deal is closed_lost (e.g.
  // "competitor", "budget", "no decision"). Optional on close.
  closedLostReason   String?    @db.Text
  // Forecast deal size in whole dollars. Optional — many founder-led
  // deals are sized later in the cycle. Used for sort + filtering
  // on /deals and (eventually) pipeline value aggregations.
  dealValue          Int?
  // Holistic deal-health rating produced by the analyzer
  // ("poor" | "fair" | "good" | "excellent"). null when never
  // analyzed. Shown as the "Mikey Health" pill on /deals and the
  // detail page.
  mikeyHealth        String?

  // Linked shared Slack channel (Slack Connect selling channel with
  // the prospect). The 5-min cron pulls new messages since
  // slackChannelLastTs and lands them as slack_message timeline
  // digest entries — deal evidence like everything else.
  slackChannelId     String?
  slackChannelName   String?
  slackChannelLastTs String?

  notes String? @db.Text

  // Latest AI state assessment (JSON)
  lastAnalysis   String?   @db.Text
  lastAnalyzedAt DateTime?

  // Optional link to a Project (chat folder)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  participants DealParticipant[]
  entries      DealTimelineEntry[]
  analyses     DealAnalysis[]
  businessCaseInstances BusinessCaseInstance[]
  slackPosts   DealSlackPost[]
  tasks        DealTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([projectId])
  @@map("deals")
}

// Per-account customizable deal stages. Built-in stages (Prospecting,
// Discovery, Demo, Proposal, Negotiation, Closing, Won, Lost) live in
// src/lib/deals/constants.ts and apply to every account. Rows in this
// table get merged in (sorted by `order`) to extend or replace the
// built-in pipeline for a specific account.
model CustomDealStage {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  value     String   // slug used on Deal.stage (e.g. "vendor-review")
  label     String   // display text (e.g. "Vendor Review")
  color     String   // Tailwind class set (e.g. "bg-pink-100 text-pink-700")
  order     Int      @default(0)
  archived  Boolean  @default(false)
  // Which built-in stage this custom stage sits after in the
  // pipeline. e.g. "demo" → renders between Demo and Proposal.
  // null = appended at the end of the pipeline.
  insertAfter String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, value])
  @@index([accountId, archived])
  @@map("custom_deal_stages")
}

// Per-account custom closed-lost reasons. Built-in reasons (Unqualified,
// Budget, Timing, Competition, etc.) live in src/lib/deals/constants.ts;
// rows here let an account add or archive choices without a code change.
// Archived rows stay in the DB so any Deal.closedLostReason already
// pointing at the slug still displays after archive.
model CustomClosedLostReason {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  value     String   // slug stored on Deal.closedLostReason
  label     String   // display text
  order     Int      @default(0)
  archived  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, value])
  @@index([accountId, archived])
  @@map("custom_closed_lost_reasons")
}

// Bookkeeping for the hourly call-recorder scanner so we don't
// re-process the same recording on every tick. One row per
// (user, providerCallId). When a call gets attached to an existing
// deal we store its dealId; when it spawns a brand-new potential
// deal we also record that. `result` tells the scanner what
// happened so future runs can short-circuit.
model ProcessedRecording {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider        String   // recorder slug ("fathom" | "fireflies" | "granola")
  providerCallId  String
  // "attached_existing" — a meeting was added to an existing deal
  // "created_potential" — a new auto-detected deal was spun up
  // "skipped_internal_only" — call had no external attendees
  // "skipped_no_domain"    — couldn't infer a company domain
  result          String
  dealId          String?
  notes           String?
  createdAt       DateTime @default(now())

  @@unique([userId, providerCallId])
  @@index([userId, createdAt])
  @@map("processed_recordings")
}

model DealParticipant {
  id String @id @default(cuid())

  dealId String
  deal   Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  name        String
  title       String?
  company     String?
  email       String?
  linkedinUrl String?

  role String @default("unknown") // "champion" | "decision_maker" | "influencer" | "blocker" | "end_user" | "unknown"

  // Cached PDL enrichment
  pdlData        String?   @db.Text
  pdlEnrichedAt  DateTime?

  notes String? @db.Text

  createdAt DateTime @default(now())

  @@index([dealId])
  @@map("deal_participants")
}

model DealTimelineEntry {
  id String @id @default(cuid())

  dealId String
  deal   Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  type String // "call_transcript" | "call_summary" | "email" | "screenshot" | "note" | "linkedin" | "document"

  title     String?
  content   String  @db.Text
  sourceUrl String?
  metadata  String? @db.Text // JSON: { callType?, participants?, extractedFrom?, imageDescription?, etc. }

  order     Int      @default(0)
  entryDate DateTime @default(now()) // when this engagement happened

  createdAt DateTime @default(now())

  @@index([dealId, entryDate(sort: Desc)])
  @@map("deal_timeline_entries")
}

model DealAnalysis {
  id String @id @default(cuid())

  dealId String
  deal   Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  analysis String  @db.Text
  stage    String? // suggested stage extracted from the analysis (if any)

  // Snapshot counts so we can show "after N entries" in the history without loading relations
  entryCount       Int @default(0)
  participantCount Int @default(0)

  createdAt DateTime @default(now())

  @@index([dealId, createdAt(sort: Desc)])
  @@map("deal_analyses")
}

// ============================================
// BUSINESS CASES SUITE
// Discovery Summary · ROI Model · Business Case
// ============================================
//
// Three sibling artifact types share ONE discriminated pair of tables
// (see business-cases-plan.md) instead of three more near-identical
// Version tables. `type` is the discriminator everywhere:
//   "discovery_summary" | "roi_model" | "business_case"

// Per-user template, versioned by row (newest row of a type = current).
// Generated from playbook assets (sales narrative, value prop,
// discovery questions, first-call checklist) then hand-edited until it
// reflects the founder's economic argument and discovery structure.
model BusinessCaseTemplate {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String // "discovery_summary" | "roi_model" | "business_case"
  content String @db.Text // markdown, {{PLACEHOLDER}} slots for instance fill

  // Provenance: which playbook inputs seeded the generation
  // (ids + labels as JSON), so regenerate can diff/refresh when the
  // narrative changes. Null for hand-authored templates.
  sourceInputs Json?

  createdAt DateTime @default(now())

  @@index([userId, type, createdAt(sort: Desc)])
  @@map("business_case_templates")
}

// A generated + user-edited artifact. dealId null = ad-hoc run (pasted
// transcripts / picked calls with no deal attached). Instances are the
// source of truth — deal-triggered runs ALSO mirror into a
// DealTimelineEntry (metadata.instanceId links the pair; edits here
// sync the entry).
model BusinessCaseInstance {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type       String // same discriminator as BusinessCaseTemplate
  templateId String? // template version used at generation time

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  title   String // e.g. "Acme Corp — Discovery Summary"
  content String @db.Text // markdown; editable in place

  // What we fed the model (transcript titles/dates, deal snapshot
  // summary) — for regeneration and "what was this based on?" display.
  sourceContext String? @db.Text

  // Gamma slide-deck export of this artifact (discovery readout deck
  // etc.). Set by /instances/[id]/gamma; regenerating overwrites.
  // Same trio as SalesDeckVersion.
  gammaUrl     String?
  gammaPdfUrl  String?
  gammaPptxUrl String?
  gammaGeneratedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type, createdAt(sort: Desc)])
  @@index([dealId, type])
  @@map("business_case_instances")
}

// ============================================
// HIRING — CANDIDATE ASSESSMENT
// ============================================

/// One grading run of one candidate against the founder's hiring bar.
/// Runs are IMMUTABLE — re-grading writes a new row — so the UI can
/// show a history ("assessed Jul 3 · re-assessed Aug 11 against the
/// new profile") and so a verdict is always traceable to the bar and
/// rubric in force at the time.
/// A saved candidate search.
///
/// Sourcing used to hold everything in page state, which meant a
/// refresh threw away the imported companies, the leads AND the
/// enrichment credits already spent on them. Persisting the search
/// makes it addressable — /sourcing/<id> — so it can be bookmarked,
/// shared with whoever else is hiring, and returned to next week.
///
/// The CRITERIA are stored, not just the results: a search a founder
/// wants back is usually one they want to re-run, and re-deriving the
/// filters from a list of people is impossible.
model SourcingSearch {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Human label. Derived from the companies searched when not set.
  name     String?
  /// Which seat this hunt is for — drives the tenure rubric on enrich.
  roleType String  @default("AE")

  /// Resolved companies: [{ name, tier, group, apolloOrgId }]. The
  /// Apollo ids are kept so a re-run doesn't have to resolve again.
  companies Json
  /// Job titles searched, as given.
  titles    Json
  /// Person locations, as given.
  locations Json
  /// ["alumni"], ["current"], or both. One Apollo query runs per entry.
  modes     Json

  yoeMin Int?
  yoeMax Int?

  /// Apollo's reported match count at the time of the run, which is
  /// usually larger than the page of leads actually stored.
  totalFound Int      @default(0)
  lastRunAt  DateTime @default(now())

  leads SourcingLead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@map("sourcing_searches")
}

/// One person found by a search, plus whatever enrichment has been
/// bought for them.
///
/// A lead is NOT a candidate assessment. Apollo search returns an id, a
/// first name, a masked surname and a title — nothing judgeable. The
/// enrichment columns stay null until someone spends a credit, and
/// storing them means that spend is never repeated for the same person.
model SourcingLead {
  id       String         @id @default(cuid())
  searchId String
  search   SourcingSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  /// Denormalized so lead queries can be scoped without a join.
  userId   String

  /// Apollo's person id — the only durable handle a search result has.
  apolloId         String
  firstName        String?
  /// e.g. "Ch***e". Apollo masks surnames until enrichment.
  lastNameMasked   String?
  title            String?
  organizationName String?
  /// Which relationship surfaced them: ["alumni"], ["current"], or both.
  via              Json?

  /// ── Enrichment. Null until bought. ──
  enrichedAt    DateTime?
  name          String?
  linkedinUrl   String?
  headline      String?
  /// Per-EMPLOYER aggregation: [{ company, start, end, current, months, titles }].
  employers     Json?
  shortStints   Int?
  /// "clean" | "pattern" | "disaster", against the role's rubric.
  tenureVerdict String?

  /// Triage state: "new" | "shortlisted" | "passed".
  status String @default("new")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A person appears once per search, so re-running merges rather than
  /// duplicating — and keeps the enrichment already paid for.
  @@unique([searchId, apolloId])
  @@index([userId])
  @@index([searchId, status])
  @@map("sourcing_leads")
}

model CandidateAssessment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Groups every run for the same human: normalized LinkedIn slug
  /// when we have one, else a name+employer slug.
  candidateKey  String
  candidateName String
  linkedinUrl   String?

  /// Which hiring bar this was graded against (null when the founder
  /// hasn't authored a profile — we grade on narrative/ICP/stage).
  hiringProfileVersionId String?
  /// Stage snapshot, so an old report still reads correctly after the
  /// company moves stage.
  maturityStage String?

  /// "pdl" | "pdf" | "pasted" | "manual" | "merged"
  source     String
  roleLabel  String @default("AE")

  /// Normalized timeline + PDL payloads + extracted claims — lets a
  /// re-grade skip re-spending enrichment credits.
  rawProfile Json
  /// The report (see candidate-assessment-plan.md for the contract).
  assessment Json
  /// Denormalized for list filtering/sorting.
  verdict    String

  /// A report kept for months must stay interpretable after the
  /// rubric moves.
  rubricVersion String @default("v1")
  model         String @default("gpt-5.5")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, candidateKey, createdAt(sort: Desc)])
  @@map("candidate_assessments")
}

// ============================================
// DEAL AUTOPILOT — TRIAGE
// ============================================

// One row per (user, calendar event | recording) judgment by the deal
// autopilot (see deal-autopilot-plan.md). Triple duty: dedupe guard so
// the 5-min cron never re-classifies an event, audit trail of every
// machine verdict, and the source for the "correct me" digest of
// unlikely-deal calls. overriddenAt marks human corrections.
model DealTriage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  source   String // "calendar" | "recording"
  sourceId String // calendarEventId or recorder callId
  eventAt  DateTime // meeting start / call time
  title    String?

  verdict    String // "likely_deal" | "unlikely_deal" | "confirmed_deal" | "not_a_deal"
  category   String? // prospect_first_call | vendor_pitch_to_us | fundraising | recruiting | internal | personal | existing_customer | unknown
  confidence Float?
  borderline Boolean @default(false)
  reason     String? @db.Text

  dealId       String? // set when a deal was created/matched
  overriddenAt DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, source, sourceId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("deal_triages")
}

// Quotes & Success Stories (success-stories-plan.md). One collection
// per customer/story: pasted/imported call sources + optional theme
// focus → extracted PROOF POINTS (verbatim-quoted, narrative-aligned,
// metric-carrying — the durable layer) → generated assets across
// mediums (testimonial / blind / story / case study) × formats.
model SuccessStoryCollection {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title        String
  customerName String?
  dealId       String? // optional deal linkage (Phase 2 CTA)
  themeFocus   String? @db.Text

  // [{ id, title, date, origin: "paste"|"recorder"|"deal", content }]
  sources Json
  // [{ id, claim, quote, speaker, role?, date?, metric?,
  //    narrativePillar?, arc, themeMatch, included }]
  proofPoints   Json?
  proofPointsAt DateTime?

  assets SuccessAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt(sort: Desc)])
  @@map("success_story_collections")
}

model SuccessAsset {
  id           String                 @id @default(cuid())
  collectionId String
  collection   SuccessStoryCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  medium  String // testimonial | blind_testimonial | success_story | blind_success_story | case_study | blind_case_study
  format  String // web | linkedin | tweet | slides
  content String @db.Text

  createdAt DateTime @default(now())

  @@index([collectionId, createdAt(sort: Desc)])
  @@map("success_assets")
}

// Future-dated deal tasks with one-touch execution (deal-autopilot-
// plan.md Part 3 / Phase 5, first slice). A task sleeps until dueAt;
// the 5-min cron then drafts the founder-voiced message and pings
// Slack ("⚡ Proposed Task Execution") with a Do-it link that sends it
// into the deal's linked channel AS THE FOUNDER (user token), logs a
// timeline entry as proof, and marks the task done.
model DealTask {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  title     String
  rationale String? @db.Text
  source    String  @default("user") // "user" | "deal_analysis" | "pipeline_review"
  // scheduled → (dueAt reached, ping posted) → pinged → done|dismissed
  status String    @default("scheduled")
  dueAt  DateTime?

  // How the one-touch execution happens. "slack_channel" sends
  // draftMessage into the deal's linked Slack channel. (Future:
  // "email", …)
  executeVia   String?
  draftMessage String? @db.Text
  proofEntryId String? // timeline entry evidencing execution
  executedAt   DateTime?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([userId, status, dueAt])
  @@index([dealId, status])
  @@map("deal_tasks")
}

// One row per deal-related Slack stub post (deal-autopilot-plan.md
// Part 2). Serves two jobs: (a) dedupe — "did we already post the
// pre-call plan for THIS meeting?" via the (dealId, kind, sourceRef)
// unique key; (b) Phase 4 inbound routing — a reply under any stub
// resolves (slackChannelId, slackTs=thread_ts) → dealId
// deterministically, no name matching.
model DealSlackPost {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  // "deal_detected" | "deal_confirmed" | "deal_dismissed" |
  // "precall_plan" | "analysis_update" | "no_recording_nudge"
  kind String
  // Natural dedupe key for at-most-once kinds (precall_plan →
  // meeting entry id, no_recording_nudge → "once"). Repeatable kinds
  // (confirmed/dismissed after Undo, analysis updates) store the
  // slack ts here so the unique key never collides.
  sourceRef String @default("")

  slackChannelId String
  slackTs        String

  createdAt DateTime @default(now())

  @@unique([dealId, kind, sourceRef])
  @@index([slackChannelId, slackTs])
  @@index([userId, createdAt(sort: Desc)])
  @@map("deal_slack_posts")
}

// ============================================
// PRACTICE SUITE
// ============================================

// One drill attempt (see practice-suite-plan.md). The synthetic buyer
// is snapshotted into `persona` as { public, hidden, quiz } — the
// hidden dossier is STRIPPED from API responses until the session is
// completed (graded), then revealed alongside the report card.
// dealId / meetingEntryId are reserved for Live-Fire mode (Phase 6):
// practice anchored to a real upcoming call on a real deal.
model PracticeSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  drill String // "precall_plan" | "rapport" | "agenda" | "discovery"
  mode  String? // drill-specific: "script_visible" | "script_hidden" | "two_level" | "freestyle"

  persona Json // { public: {...}, hidden: {...}, quiz: {...}, voice?: string }
  turns   Json? // [{ role: "user"|"persona"|"coach", text, audioDurationMs?, at }]
  answers Json? // structured quiz answers (pre-call drill)
  score   Json? // { overall, dimensions: [{name, score, max, comment}], modelAnswer, nextRep }

  status String @default("active") // "active" | "completed" | "abandoned"

  dealId         String?
  meetingEntryId String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId, drill, createdAt(sort: Desc)])
  @@map("practice_sessions")
}
