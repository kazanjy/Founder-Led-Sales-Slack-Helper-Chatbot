// ============================================
// SALES MOTION ANALYZER
// ============================================

model SalesMotionCollection {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title  String @default("Sales Motion Analysis")
  status String @default("draft") // "draft" | "processing" | "complete"

  // Synthesized output
  salesMotionSynthesis String? @db.Text

  deals   SalesMotionDeal[]
  scripts SalesMotionCallScript[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("sales_motion_collections")
}

model SalesMotionDeal {
  id           String @id @default(cuid())
  collectionId String
  collection   SalesMotionCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  name      String? // AI-generated
  outcome   String? // "won"
  dealOrder Int     @default(0)

  calls SalesMotionCall[]

  createdAt DateTime @default(now())

  @@index([collectionId])
  @@map("sales_motion_deals")
}

model SalesMotionCall {
  id     String @id @default(cuid())
  dealId String
  deal   SalesMotionDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  // User inputs
  summary       String? @db.Text
  transcript    String? @db.Text
  recordingUrl  String? // Public URL of the call recording (e.g., Fathom, Gong, Chorus share link)

  // AI-generated
  name      String?
  callType  String? // "discovery" | "demo" | "proposal" | "negotiation" | "security" | "technical" | "closing" | "other"
  callOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@index([dealId])
  @@map("sales_motion_calls")
}

model SalesMotionCallScript {
  id           String @id @default(cuid())
  collectionId String
  collection   SalesMotionCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  callType        String // "discovery" | "demo" | "proposal" etc.
  title           String
  content         String @db.Text
  sourceCallCount Int    @default(0)

  iterationHistory String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([collectionId])
  @@map("sales_motion_call_scripts")
}

// ============================================
// CALL RECAP EMAIL
// ============================================

model CallRecapVersion {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Inputs
  recordingUrl   String         // REQUIRED — public URL of call recording
  callSummary    String @db.Text
  callTranscript String? @db.Text
  customNotes    String? @db.Text

  // AI-generated
  title        String  // "Acme Corp - Discovery Call - Pete + Sarah"
  callType     String  // "discovery" | "demo" | "proposal" | etc.
  emailSubject String  // Generated subject line
  emailBody    String  @db.Text // Generated email body

  // Iteration
  iterationHistory String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("call_recap_versions")
}

// ============================================
// SALES ASSET LIBRARY
// ============================================

model SalesAsset {
  id String @id @default(cuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text
  category    String // "messaging" | "materials" | "process" | "onboarding" | "legal" | "custom"
  isDefault   Boolean @default(false)
  archived    Boolean @default(false)
  slotKey     String? // stable key for defaults: "salesNarrative", "demoScript", etc.
  order       Int     @default(0)

  // Denormalized latest version for fast rendering
  currentUrl       String?
  currentLabel     String?
  currentVersionId String?

  versions SalesAssetVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, slotKey])
  @@index([accountId])
  @@map("sales_assets")
}

model SalesAssetVersion {
  id String @id @default(cuid())

  assetId String
  asset   SalesAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  url   String
  label String?
  notes String? @db.Text

  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([assetId, createdAt])
  @@map("sales_asset_versions")
}

// ============================================
// DEALS
// ============================================

model Deal {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String // "Visana - Enterprise Deal"
  companyName String // "Visana Health"
  companyUrl  String? // for PDL company enrichment

  stage  String @default("prospecting") // "prospecting" | "discovery" | "demo" | "proposal" | "negotiation" | "closing" | "won" | "lost"
  status String @default("active") // "active" | "stalled" | "closed_won" | "closed_lost"

  notes String? @db.Text

  // Latest AI state assessment (JSON)
  lastAnalysis   String?   @db.Text
  lastAnalyzedAt DateTime?

  // Optional link to a Project (chat folder)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  participants DealParticipant[]
  entries      DealTimelineEntry[]
  analyses     DealAnalysis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([projectId])
  @@map("deals")
}

model DealParticipant {
  id String @id @default(cuid())

  dealId String
  deal   Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  name        String
  title       String?
  company     String?
  email       String?
  linkedinUrl String?

  role String @default("unknown") // "champion" | "decision_maker" | "influencer" | "blocker" | "end_user" | "unknown"

  // Cached PDL enrichment
  pdlData        String?   @db.Text
  pdlEnrichedAt  DateTime?

  notes String? @db.Text

  createdAt DateTime @default(now())

  @@index([dealId])
  @@map("deal_participants")
}

model DealTimelineEntry {
  id String @id @default(cuid())

  dealId String
  deal   Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  type String // "call_transcript" | "call_summary" | "email" | "screenshot" | "note" | "linkedin" | "document"

  title     String?
  content   String  @db.Text
  sourceUrl String?
  metadata  String? @db.Text // JSON: { callType?, participants?, extractedFrom?, imageDescription?, etc. }

  order     Int      @default(0)
  entryDate DateTime @default(now()) // when this engagement happened

  createdAt DateTime @default(now())

  @@index([dealId, entryDate(sort: Desc)])
  @@map("deal_timeline_entries")
}

model DealAnalysis {
  id String @id @default(cuid())

  dealId String
  deal   Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  analysis String  @db.Text
  stage    String? // suggested stage extracted from the analysis (if any)

  // Snapshot counts so we can show "after N entries" in the history without loading relations
  entryCount       Int @default(0)
  participantCount Int @default(0)

  createdAt DateTime @default(now())

  @@index([dealId, createdAt(sort: Desc)])
  @@map("deal_analyses")
}
