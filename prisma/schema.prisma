  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Snapshot of answers at generation time
  answers SalesNarrativeAnswer[]

  // Generated outputs
  title            String  @default("Sales Narrative") // Descriptive title e.g. "ProductName - Category - Sales Narrative"
  narrative        String  @db.Text // Full sales narrative prose (~2000 words, used for context attachment)
  description1000w String? @db.Text // 1000-word condensed narrative
  description100w  String  @db.Text // 100-word product description
  description50w   String  @db.Text // 50-word elevator pitch
  description25w   String  @db.Text // 25-word tagline

  // Sources used to create this narrative (from prefill)
  sourceUrls       String[] @default([]) // URLs crawled from website
  sourcePdfNames   String[] @default([]) // Names of uploaded PDF files
  sourceImageNames String[] @default([]) // Names of uploaded image (PNG/JPG/etc.) files

  // Cached extracted text for each source so the Extend flow can
  // reuse the original tokens without re-crawling / re-OCRing PDFs
  // that may no longer be accessible. One row per (versionId, key).
  sources NarrativeSource[]

  // Iteration tracking
  iterationHistory String[] @default([])

  // Optional: conversation for follow-up chat about the narrative
  conversationId String?

  // Discovery questions generated from this narrative
  discoveryQuestionsVersions DiscoveryQuestionsVersion[]
  objectionBootstraps        ObjectionBootstrap[]

  // Sequences generated from this narrative
  emailSequenceVersions    EmailSequenceVersion[]
  linkedInSequenceVersions LinkedInSequenceVersion[]
  coldCallScriptVersions   ColdCallScriptVersion[]
  salesDeckVersions        SalesDeckVersion[]
  adCreatorVersions        AdCreatorVersion[]
  socialContentVersions    SocialContentVersion[]
  icpVersions              IcpVersion[]

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("sales_narrative_versions")
}

// ============================================
// NARRATIVE SOURCE CACHE
// ============================================

// Cached extracted text from each source (URL or PDF) used to
// generate a SalesNarrativeVersion. Lets the Extend flow combine
// the original tokens with newly-added sources without re-crawling
// or re-OCRing PDFs that the user may no longer have around.
model NarrativeSource {
  id String @id @default(cuid())

  versionId String
  version   SalesNarrativeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String // "url" | "pdf"
  key     String // URL or filename
  content String @db.Text // extracted text (capped at ~200k chars)
  chars   Int    @default(0) // for quick UI display + size budgeting

  createdAt DateTime @default(now())

  @@unique([versionId, type, key])
  @@index([userId, type, key])
  @@map("narrative_sources")
}

