// ============================================
// PRE-CALL RESEARCH APP
// ============================================

// Pre-call research briefs generated from web search
model PreCallResearch {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Research input
  companyName     String
  contactName     String?
  contactTitle    String?
  contactEmail    String?
  contactLinkedIn String?
  freeformInput   String? @db.Text

  // Snapshot of the calendar event the brief was triggered from
  // (title, start/end, attendees, description, location, meeting
  // URL). JSON so it can grow without further migrations. Null when
  // the brief was created from the manual form rather than a
  // calendar tile.
  calendarEvent   Json?

  // Generated research brief (markdown)
  content String @db.Text

  // Full search context prompt sent to the LLM for synthesis
  searchContext String? @db.Text

  // Sources used (JSON array of {title, url})
  sources Json @default("[]")

  // Source of the request
  source String @default("web") // "web" | "slack"

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, companyName])
  @@map("pre_call_research")
}

// Saved title-pattern → Slack destination rules that the daily cron
// uses to auto-generate pre-call research briefs for the user's
// matching calendar events.
model RecurringResearchPattern {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Case-insensitive substring matched against the calendar event
  // title. e.g. "Discovery" matches any event with "discovery" in
  // its name.
  titlePattern String
  // "dm" — post to the user's MikeyBot DM
  // "channel" — post to a specific Slack channel
  destination  String
  channelId    String?
  channelName  String?
  enabled      Boolean  @default(true)
  lastRunAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, enabled])
  @@map("recurring_research_patterns")
}

// One row per (pattern, calendar event) the cron has already
// processed so we never re-post the same brief on later runs.
model RecurringResearchRun {
  id              String   @id @default(cuid())
  userId          String
  patternId       String
  calendarEventId String
  status          String   // "sent" | "enrichment_failed" | "brief_failed" | "post_failed"
  researchId      String?
  notes           String?
  createdAt       DateTime @default(now())

  @@unique([patternId, calendarEventId])
  @@index([userId, createdAt])
  @@map("recurring_research_runs")
}

// Tracks multi-turn research intake via Slack
// Stores extracted fields while waiting for the user to confirm or provide missing info
model PendingResearchRequest {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Slack thread coordinates so we can match follow-up replies
  slackChannel  String
  slackThreadTs String

  // Extracted fields (accumulated across turns)
  companyName     String?
  companyDomain   String?
  contactName     String?
  contactTitle    String?
  contactLinkedIn String?
  urls            Json    @default("[]") // string[]

  // Status: gathering → ready → completed / expired
  status String @default("gathering") // "gathering" | "completed" | "expired"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slackChannel, slackThreadTs])
  @@index([userId, status])
  @@map("pending_research_requests")
}

// User preferences for prompt attachments
model UserAttachmentPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // JSON structure for flexibility:
  // {
  //   "salesNarrative": { "enabled": true, "disabledUntil": null },
  //   "gtmAssessment": { "enabled": false, "disabledUntil": "2024-02-24T10:00:00Z" },
  //   "discoveryQuestions": { "enabled": false, "disabledUntil": null },
  //   "firstCallChecklist": { "enabled": false, "disabledUntil": null }
  // }
  preferences Json @default("{}")

  updatedAt DateTime @updatedAt

  @@map("user_attachment_preferences")
}

