generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Account for multi-user shared GTM context
model Account {
  id   String @id @default(cuid())
  name String // Company/team name (e.g., "Acme Corp")

  // Email domain used for auto-grouping (e.g., "acme.com")
  emailDomain String? @unique

  users         User[]
  channelClaims ChannelClaim[]
  salesReadinessItems SalesReadinessAccountItem[]
  salesAssets   SalesAsset[]
  customDealStages CustomDealStage[]
  customClosedLostReasons CustomClosedLostReason[]
  // Built-in deal stages the account has hidden from the picker.
  // Stored as the stage value (e.g. "negotiation") rather than label
  // so renaming a built-in label later wouldn't orphan the archive.
  archivedBuiltinStages String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("accounts")
}

enum AccountRole {
  OWNER // Created the account, can manage members + billing
  ADMIN // Can invite/remove members, edit all artifacts
  MEMBER // Can create artifacts, view all account artifacts
}

// Slack workspace that has installed Mikey
model Workspace {
  id                String   @id @default(cuid())
  slackTeamId       String   @unique
  slackTeamName     String
  installedAt       DateTime @default(now())
  installedByUserId String?

  // Bot token for this workspace (from OAuth)
  botToken  String
  botUserId String? // The bot's user ID in this workspace

  // Trial config (null = use global defaults)
  trialDays     Int?
  trialMessages Int?

  // Rate limiting (null = use global default of 1000)
  dailyMessageLimit Int?

  // Workspace-level license
  workspaceLicenseId String?
  workspaceLicense   License? @relation("WorkspaceLicense", fields: [workspaceLicenseId], references: [id])

  users         User[]
  conversations Conversation[]
  channelClaims ChannelClaim[]
  broadcastCampaigns BroadcastCampaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workspaces")
}

// A user within a workspace
model User {
  id String @id @default(cuid())

  // Slack identity (optional - null for web-only users)
  slackUserId   String?
  slackUserName String?
  slackEmail    String?

  // User-scope OAuth token (xoxp-…) granted on Slack install when the
  // user OK's user_scope. Used by the broadcast tool to post messages
  // *as this user* instead of as MikeyBot. Plain text at rest for now —
  // matches Workspace.botToken; encrypting both is a separate cleanup.
  slackUserToken  String?
  slackUserScopes String?

  // Google identity (optional - null for Slack-only users)
  googleId String? @unique

  // Google OAuth tokens for API access (Calendar, etc). Populated when
  // the user grants extra scopes beyond basic identity. Plain text at
  // rest for parity with slackUserToken; encrypting the family is a
  // separate cleanup pass.
  googleAccessToken     String?
  googleRefreshToken    String?
  googleTokenExpiresAt  DateTime?
  googleScopes          String?

  // Saved Slack channel for pre-call research "Send to Slack" — set
  // the first time a user picks a channel so subsequent posts skip
  // the picker. Nullable; users without a saved channel still get
  // the picker UI.
  preferredResearchSlackChannelId   String?
  preferredResearchSlackChannelName String?

  // Email - primary identifier for web-only users
  email           String?  @unique
  secondaryEmails String[] @default([]) // Additional emails that can be used for auth lookup
  name            String?
  avatarUrl       String?

  // Account membership (null for legacy solo users)
  accountId   String?
  account     Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountRole AccountRole @default(MEMBER)

  // Workspace (optional - null for web-only users)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Trial tracking
  trialStartedAt         DateTime?
  trialMessagesRemaining Int       @default(0)

  // License status
  licenseStatus LicenseStatus @default(TRIAL)
  licenseId     String?
  license       License?      @relation(fields: [licenseId], references: [id])

  // Rate limiting
  messagesToday       Int      @default(0)
  messageCountResetAt DateTime @default(now())

  // Referral
  referralCode        String  @unique @default(cuid())
  referredByUserId    String?
  referredBy          User?   @relation("Referrals", fields: [referredByUserId], references: [id])
  referrals           User[]  @relation("Referrals")
  bonusMessagesEarned Int     @default(0)

  // Relations
  conversations              Conversation[]
  projects                   Project[]
  messages                   Message[]
  referralsMade              Referral[]                  @relation("Referrer")
  referralsReceived          Referral[]                  @relation("Referred")
  sharedConversations        SharedConversation[]
  sharedDocuments            SharedDocument[]
  chatSharesSent             ChatShare[]                 @relation("ChatSharesSent")
  chatSharesReceived         ChatShare[]                 @relation("ChatSharesReceived")
  chatViews                  ChatView[]
  meetingRecorderConnections MeetingRecorderConnection[]
  sessions                   Session[]
  savedPrompts               SavedPrompt[]
  salesAssetVersions         SalesAssetVersion[]
  deals                      Deal[]
  dismissedDefaultPromptIds  String[]                    @default([]) // Track deleted default prompts so they don't reappear
  promptGuidance             String?                     @db.Text // User's custom prompt guidance (tone, style, etc.)
  gtmVariables               GtmVariable[]
  maturityAnswers            MaturityAnswer[]
  maturityAssessments        MaturityAssessment[]
  salesNarrativeAnswers      SalesNarrativeAnswer[]
  salesNarrativeVersions     SalesNarrativeVersion[]
  narrativeSources           NarrativeSource[]
  discoveryQuestionsVersions DiscoveryQuestionsVersion[]
  firstCallChecklistVersions FirstCallChecklistVersion[]
  preCallPlanningVersions    PreCallPlanningVersion[]
  preCallResearch            PreCallResearch[]
  recurringResearchPatterns  RecurringResearchPattern[]
  preCallEnrichmentAttempts  PreCallEnrichmentAttempt[]
  processedRecordings        ProcessedRecording[]
  pendingResearchRequests    PendingResearchRequest[]
  emailSequenceVersions      EmailSequenceVersion[]
  linkedInSequenceVersions   LinkedInSequenceVersion[]
  businessCaseTemplates      BusinessCaseTemplate[]
  businessCaseInstances      BusinessCaseInstance[]
  practiceSessions           PracticeSession[]
  dealTriages                DealTriage[]
  dealSlackPosts             DealSlackPost[]
  candidateAssessments       CandidateAssessment[]
  sourcingSearches           SourcingSearch[]
  dealTasks                  DealTask[]
  successStoryCollections    SuccessStoryCollection[]
  coldCallScriptVersions     ColdCallScriptVersion[]
  salesDeckVersions          SalesDeckVersion[]
  callReviewVersions         CallReviewVersion[]
  salesMetricsAnswers        SalesMetricsAnswer[]
  salesMetricsAssessments    SalesMetricsAssessment[]
  coachingSessions           CoachingSession[]
  salesMaturityStage         SalesMaturityStage?
  coachingGoals              CoachingGoal[]
  coachingTasks              CoachingTask[]
  coachingMetricDefinitions  CoachingMetricDefinition[]
  coachingMetricEntries      CoachingMetricEntry[]
  coachingNextGoals          CoachingNextGoal[]
  coachingNextTasks          CoachingNextTask[]
  adCreatorVersions          AdCreatorVersion[]
  socialContentVersions      SocialContentVersion[]
  socialContentExamples      SocialContentExample[]
  objectionEntries           ObjectionEntry[]
  objectionBootstraps        ObjectionBootstrap[]
  icpVersions                IcpVersion[]
  hiringProfileQuestionAnswers HiringProfileAnswer[]
  hiringProfileVersions        HiringProfileVersion[]
  salesLeaderProfileAnswers    SalesLeaderProfileAnswer[]
  salesLeaderProfileVersions   SalesLeaderProfileVersion[]
  preHireAssessmentVersions    PreHireAssessmentVersion[]
  salesMotionCollections       SalesMotionCollection[]
  callRecapVersions            CallRecapVersion[]
  attachmentPreference       UserAttachmentPreference?
  uploadedFiles              UserFile[]
  channelClaims              ChannelClaim[]

  // Track update-in-progress state for maturity assessment
  maturityUpdateInProgress Boolean   @default(false)
  maturityUpdateIndex      Int? // Current question index in update mode (0-based)
  maturityUpdateStartedAt  DateTime?

  // Activity tracking
  lastActiveAt DateTime?

  // Proactive pre-call research settings. The daily cron uses these
  // to decide whether to brief every external meeting on the user's
  // calendar (all_external — default), only meetings whose titles
  // match a saved RecurringResearchPattern (title_match), or to
  // skip the user entirely (off). Destination + mutedDomains apply
  // when mode = all_external.
  preCallResearchMode          String?  @default("all_external") // "all_external" | "title_match" | "off"
  preCallResearchDestination   String?  @default("dm")            // "dm" | "channel"
  preCallResearchMutedDomains  String[] @default([])

  // Stage 2: when true, the daily research cron also spawns a
  // Potential deal (with 30-day per-domain cooldown) for every
  // external meeting it briefs. Off by default — the recorder
  // pipeline already covers most attribution and pollution of the
  // deals board is hard to undo.
  createDealsFromCalendar Boolean @default(false)

  // Onboarding overlay state. Tracks per-step dismissal so the recorder →
  // calendar → narrative prompt sequence on /chat can be suppressed without
  // hiding the underlying integration widgets. Shape:
  //   { recorder: { dismissedUntil: ISO|null, dismissedForever: boolean },
  //     calendar: { ... }, narrative: { ... } }
  onboardingState Json?

  // Broadcast campaigns this user (as an admin) created.
  createdBroadcastCampaigns BroadcastCampaign[] @relation("BroadcastCampaignCreatedBy")

  // Coaching comments authored by this user.
  coachingComments CoachingComment[] @relation("CoachingCommentAuthor")

  // Audit trail for admin "Ask This Account" queries this user has run.
  adminContextQueries AdminContextQuery[] @relation("AdminContextQueryAdmin")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Slack users identified by slackUserId + workspaceId combo
  // Web-only users identified by email or googleId (see @unique above)
  @@unique([slackUserId, workspaceId])
  @@map("users")
}

enum LicenseStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
}

// License for individual or workspace bundle
model License {
  id   String      @id @default(cuid())
  type LicenseType

  // For individual license
  userId String?
  users  User[]

  // For workspace bundle
  workspaceId String?
  workspaces  Workspace[] @relation("WorkspaceLicense")
  seatLimit   Int?
  seatsUsed   Int         @default(0)

  // Pricing override (null = use global defaults)
  priceFirstSeatCents      Int?
  priceAdditionalSeatCents Int?

  // Billing
  stripeCustomerId     String?
  stripeSubscriptionId String?

  // Manual override
  manuallyGranted  Boolean @default(false)
  grantedByAdminId String?
  notes            String?

  status    LicenseStatusType @default(ACTIVE)
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("licenses")
}

enum LicenseType {
  INDIVIDUAL
  WORKSPACE_BUNDLE
}

enum LicenseStatusType {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

// Saved prompts for quick access
model SavedPrompt {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emoji  String @default("💡")
  title  String
  prompt String

  // Track if this was originally a default prompt
  defaultPromptId String? // e.g. "default-1" to track resets

  // Order for drag-and-drop
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("saved_prompts")
}

// GTM Variables for merge fields in prompts
model GtmVariable {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String // Display name (e.g., "Ideal Customer Profile")
  mergeField  String // The merge field syntax (e.g., "ICP" for {{ICP}})
  description String? // Help text describing what this variable is for
  value       String? // The actual value the user has entered

  // Track if this is a default variable
  isDefault         Boolean @default(false)
  defaultVariableId String? // e.g., "default-icp" to identify default variables

  // AI Assist prompt for helping users fill this variable
  aiAssistPrompt String?

  // Order for display
  sortOrder Int @default(0)

  // History of changes
  history GtmVariableHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, mergeField])
  @@map("gtm_variables")
}

// History of changes to GTM variables
model GtmVariableHistory {
  id String @id @default(cuid())

  variableId String
  variable   GtmVariable @relation(fields: [variableId], references: [id], onDelete: Cascade)

  previousValue String // The value before the change
  changedAt     DateTime @default(now())

  @@map("gtm_variable_history")
}

// Project folder for organizing conversations
model Project {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text
  order       Int     @default(0)

  conversations Conversation[]
  deals         Deal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, order])
  @@map("projects")
}

// A conversation thread (Slack thread or web chat)
model Conversation {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String? // Null for web-only conversations
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Project folder (null = unfiled)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Source of the conversation
  source ConversationSource @default(SLACK)

  // Chat mode: CHATBASE (default RAG) or DIRECT (OpenAI GPT)
  mode ConversationMode @default(CHATBASE)

  // Slack reference (null for web conversations)
  slackChannelId String?
  slackThreadTs  String? // Thread timestamp = unique thread ID

  // Title for web conversations (auto-generated or user-set)
  title String?

  // For Chatbase context
  chatbaseConversationId String?

  // Preview
  firstMessagePreview String?
  messageCount        Int     @default(0)

  // Archived conversations (hidden from list but not deleted)
  archived Boolean @default(false)

  // Private conversations are only visible to the owner (not account-visible)
  isPrivate Boolean @default(false)

  // Whether this chat is shared with the entire account
  sharedWithAccount Boolean @default(true)

  messages                Message[]
  sharedLinks             SharedConversation[]
  chatShares              ChatShare[]
  chatViews               ChatView[]
  maturityAssessments     MaturityAssessment[]
  salesMetricsAssessments SalesMetricsAssessment[]

  // Track which attachments were included in first message
  attachmentsIncluded Json? // e.g., ["salesNarrative", "gtmAssessment"]

  // Track uploaded images/PDFs for this conversation
  imagesIncluded Json? @map("images_included") // [{name, type, storagePath, pageCount?}]

  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  @@unique([workspaceId, slackChannelId, slackThreadTs])
  @@map("conversations")
}

enum ConversationSource {
  SLACK
  WEB
}

enum ConversationMode {
  CHATBASE // Default: RAG via Chatbase knowledge base
  DIRECT // Direct OpenAI GPT calls, no RAG
}

// Individual message in a conversation
model Message {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  role    MessageRole
  content String

  // Slack reference
  slackMessageTs String?

  // Arbitrary metadata bag — used by the unified web agent to stash
  // the per-message tool-call trace (so the chat UI can render a
  // collapsible "tool calls" disclosure beneath the assistant reply).
  // Shape: { agent?: "web", turns?: number, hitTurnCap?: boolean,
  //          trace?: Array<{ name, argsJson, durationMs, resultPreview, error? }> }
  metadata Json?

  createdAt DateTime @default(now())

  @@map("messages")
}

enum MessageRole {
  USER
  ASSISTANT
}

// Referral tracking
model Referral {
  id String @id @default(cuid())

  referrerUserId String
  referrer       User   @relation("Referrer", fields: [referrerUserId], references: [id])

  referredUserId String
  referred       User   @relation("Referred", fields: [referredUserId], references: [id])

  bonusAwarded Int            @default(0)
  status       ReferralStatus @default(PENDING)

  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([referrerUserId, referredUserId])
  @@map("referrals")
}

enum ReferralStatus {
  PENDING
  COMPLETED
}

// Shared conversation link
model SharedConversation {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdByUserId String
  createdBy       User   @relation(fields: [createdByUserId], references: [id])

  shareCode String @unique

  // Optional protection
  passwordHash String?
  expiresAt    DateTime?

  viewCount Int @default(0)

  createdAt DateTime @default(now())

  @@map("shared_conversations")
}

// Cross-account chat sharing (share to specific email)
model ChatShare {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Who shared it
  sharedByUserId String
  sharedByUser   User   @relation("ChatSharesSent", fields: [sharedByUserId], references: [id], onDelete: Cascade)

  // Target recipient (by email - may not have account yet)
  sharedToEmail String

  // Resolved when recipient has an account (for efficient queries)
  sharedToUserId String?
  sharedToUser   User?   @relation("ChatSharesReceived", fields: [sharedToUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  // Can only share same chat to same email once
  @@unique([conversationId, sharedToEmail])
  @@index([sharedToEmail])
  @@index([sharedToUserId])
  @@index([sharedByUserId])
  @@map("chat_shares")
}

// Meeting recorder provider connection (Granola, Fireflies, etc.)
model MeetingRecorderConnection {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider         String   // "granola" | "fireflies" | "fathom" | "circleback"
  accessToken      String   @db.Text // Encrypted API key or OAuth token
  refreshToken     String?  @db.Text // Encrypted OAuth refresh token
  tokenExpiresAt   DateTime?
  providerAccountId String? // Provider's user/account ID
  // Per-user OAuth client credentials for providers that use RFC 7591
  // dynamic client registration (Circleback). null for providers with
  // a static, app-level clientId (Fathom). Encrypted at rest.
  providerClientId     String? @db.Text
  providerClientSecret String? @db.Text
  status           String   @default("active") // "active" | "expired" | "revoked"

  connectedAt  DateTime @default(now())
  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
  @@map("meeting_recorder_connections")
}

// Tracks when a user views a teammate's chat (for "recently viewed" feature)
model ChatView {
  id String @id @default(cuid())

  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  viewedAt DateTime @default(now())

  @@unique([userId, conversationId])
  @@index([userId, viewedAt(sort: Desc)])
  @@map("chat_views")
}

// Shared sales document link (public read-only)
model SharedDocument {
  id String @id @default(cuid())

  // Which type of document: salesNarrative, discoveryQuestions, firstCallChecklist, preCallPlanning, preCallResearch
  documentType String
  // The version/record ID being shared
  documentId   String

  createdByUserId String
  createdBy       User   @relation(fields: [createdByUserId], references: [id])

  shareCode String @unique

  // Snapshot of the document content at share time
  title   String
  content String @db.Text

  viewCount Int @default(0)

  createdAt DateTime @default(now())

  @@index([documentType, documentId])
  @@map("shared_documents")
}

// Web session for authenticated users
model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Session token (stored in cookie)
  token String @unique

  // Impersonation: if set, this session is an admin impersonating another user
  impersonatingAdminId String?

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

// Channel claim: 1:1 mapping from a Slack channel to an account + user
// An account/user can claim multiple channels, but each channel has exactly one owner.
model ChannelClaim {
  id String @id @default(cuid())

  // The Slack channel being claimed (unique — one claim per channel)
  slackChannelId   String  @unique
  slackChannelName String? // Display name (e.g., "#sales-team"), cached for convenience

  // Which workspace this channel belongs to
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Which account owns this channel
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Which user claimed it (the channel owner)
  claimedByUserId String
  claimedBy       User   @relation(fields: [claimedByUserId], references: [id], onDelete: Cascade)

  // Most recent non-bot message timestamp in this channel. Fed by the Slack
  // event handler on every incoming message; used by the admin broadcast
  // tool to rank channels by recency.
  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  broadcastDeliveries BroadcastDelivery[]

  @@index([accountId])
  @@index([workspaceId])
  @@index([workspaceId, lastMessageAt])
  @@map("channel_claims")
}

// One admin-initiated broadcast send (immediate or scheduled). Each
// campaign owns one BroadcastDelivery row per targeted channel; the
// per-channel rows are the source of truth for who-got-what and the
// idempotency key for retries.
model BroadcastCampaign {
  id String @id @default(cuid())

  // Optional admin-facing label so a list of past sends has something to
  // scan beyond the message body. Null for ad-hoc sends.
  name String?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  body String

  // null (or past) = send-now; future = drained by the cron worker.
  scheduledFor DateTime?

  // "scheduled" | "sending" | "done" | "canceled" | "failed"
  status String @default("scheduled")

  // Admin who created the campaign — kept for audit even after they leave.
  createdByAdminId String
  createdByAdmin   User   @relation("BroadcastCampaignCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  deliveries BroadcastDelivery[]

  @@index([workspaceId, status, scheduledFor])
  @@index([workspaceId, createdAt])
  @@map("broadcast_campaigns")
}

model BroadcastDelivery {
  id String @id @default(cuid())

  campaignId String
  campaign   BroadcastCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  channelClaimId String
  channelClaim   ChannelClaim @relation(fields: [channelClaimId], references: [id], onDelete: Cascade)

  // "pending" | "sent" | "failed" | "canceled"
  status String @default("pending")

  // Slack message ts so a future delete/update tool can target the post.
  slackMessageTs String?
  error          String?
  sentAt         DateTime?

  createdAt DateTime @default(now())

  // Idempotency: a worker retry can't double-post to the same channel
  // within the same campaign.
  @@unique([campaignId, channelClaimId])
  @@index([campaignId, status])
  @@map("broadcast_deliveries")
}

// Global settings (single row)
model GlobalSettings {
  id String @id @default("global")

  // Default pricing (in cents)
  defaultPriceFirstSeatCents      Int @default(9900) // $99
  defaultPriceAdditionalSeatCents Int @default(3900) // $39

  // Default trial
  defaultTrialDays     Int @default(14)
  defaultTrialMessages Int @default(50)

  // Default rate limit
  defaultDailyMessageLimit Int @default(1000)

  // Referral bonus
  referralBonusMessages Int @default(10)

  // Activity broadcast — admin-configured destination for "usage action"
  // digest reports posted into a Slack channel. All three are nullable;
  // the broadcast feature is opt-in. activityBroadcastLastSentAt is the
  // watermark used to slice "since last send" digests.
  activityBroadcastWorkspaceId  String?
  activityBroadcastChannelId    String?
  activityBroadcastChannelName  String?
  activityBroadcastLastSentAt   DateTime?

  updatedAt DateTime @updatedAt

  @@map("global_settings")
}

// Audit trail for the admin "Ask This Account" feature. Records who
// queried which account/user with what question (truncated) so the
// usage of LLM-routed customer-data queries is traceable. The
// question itself is stored in preview form only — never the answer
// or the bundled context — so the audit table doesn't itself become a
// customer-data leak channel.
model AdminContextQuery {
  id String @id @default(cuid())

  adminUserId String
  adminUser   User   @relation("AdminContextQueryAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)

  scope    String  // "account" | "user"
  targetId String  // accountId or userId depending on scope

  questionPreview String  @db.Text // first ~200 chars of the question
  itemCounts      String  @db.Text // JSON of { coachingSessions: N, assets: N, ... }
  totalChars      Int     @default(0)
  truncations     String? @db.Text // JSON array of strings naming dropped/truncated sections

  createdAt DateTime @default(now())

  @@index([adminUserId, createdAt])
  @@index([scope, targetId, createdAt])
  @@map("admin_context_queries")
}

// GTM Maturity Assessment Questions
model MaturityQuestion {
  id          String  @id @default(cuid())
  category    String // e.g., "Revenue Basics", "Value Prop", "ICP"
  globalOrder Int     @unique // Overall question number (1-56)
  question    String  @db.Text
  enabled     Boolean @default(true) // Soft delete - disabled questions are hidden but answers preserved

  answers MaturityAnswer[]

  createdAt DateTime @default(now())

  @@map("maturity_questions")
}

// User's answers to maturity assessment questions (with history)
model MaturityAnswer {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  questionId String
  question   MaturityQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // Link to specific assessment (for history tracking)
  assessmentId String?
  assessment   MaturityAssessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  answer String @db.Text

  createdAt DateTime @default(now())

  @@index([userId, questionId])
  @@index([assessmentId])
  @@map("maturity_answers")
}

// Tracks completed maturity assessments
model MaturityAssessment {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // AI-generated title summarizing the assessment
  title String?

  // Links to the conversation with AI recommendations
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  // Snapshot of all answers at time of completion
  answers MaturityAnswer[]

  completedAt DateTime @default(now())

  @@map("maturity_assessments")
}

