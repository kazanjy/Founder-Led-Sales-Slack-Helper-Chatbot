// ============================================
// COACHING FRAMEWORK — GOALS & TASKS
// ============================================

// Persistent goals that carry across coaching sessions
model CoachingGoal {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Session where this goal was originally created
  sessionId String
  session   CoachingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text
  status      String  @default("active") // "active" | "done" | "not_doing" | "deprioritized"
  statusChangedAt DateTime?

  tasks CoachingTask[]

  createdAt DateTime @default(now())
  order     Int      @default(0)

  @@index([userId, status])
  @@index([sessionId])
  @@map("coaching_goals")
}

// Tasks under goals, same carry-forward pattern
model CoachingTask {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  goalId String
  goal   CoachingGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  // Optional parent task for one-level subtasks. Capped at depth 1
  // (a subtask cannot have its own subtasks) — enforced at the API
  // layer, not in the schema, since Postgres has no native way to
  // express that without recursion checks.
  parentTaskId String?
  parentTask   CoachingTask?  @relation("CoachingTaskParent", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     CoachingTask[] @relation("CoachingTaskParent")

  title       String
  description String?  @db.Text
  status      String   @default("active") // "active" | "done" | "not_doing" | "deprioritized"
  statusChangedAt DateTime?
  // Optional priority tag. Null = unranked; otherwise "P0" / "P1" /
  // "P2". Kept as a free-form string so we can extend the scale
  // later without another migration.
  priority    String?

  createdAt DateTime @default(now())
  order     Int      @default(0)

  comments CoachingComment[]

  @@index([goalId])
  @@index([parentTaskId])
  @@map("coaching_tasks")
}

// Inline comment thread on a coaching task. Per-task only for now —
// goalId is left out of the model intentionally; if/when we extend to
// per-goal comments, the cleanest path is a new CoachingGoalComment
// table (or a discriminator on this one) with its own UI affordance.
model CoachingComment {
  id String @id @default(cuid())

  taskId String
  task   CoachingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("CoachingCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  body String @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?

  @@index([taskId, createdAt])
  @@map("coaching_comments")
}

// ============================================
// COACHING FRAMEWORK — METRICS
// ============================================

// Persistent metric definitions (templates)
model CoachingMetricDefinition {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String // "Customer Count", "ARR", or custom
  definition String? @db.Text // e.g. "Number of paying customers"
  format     String  @default("number") // "number" | "currency"
  interval   String? // "weekly" | "monthly" | "quarterly"
  isDefault  Boolean @default(false) // true for Customer Count & ARR
  archived   Boolean @default(false) // archived metrics are hidden but preserved
  order      Int     @default(0)

  // "metric" (default) — a normal data tile.
  // "section" — a full-width header strip used to group following
  // tiles into a visual section. Sections share the order column with
  // metrics but never have entries; consumers that walk this table
  // for value math should filter where { kind: "metric" }.
  kind String @default("metric")

  entries CoachingMetricEntry[]

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("coaching_metric_definitions")
}

// Per-session metric values
model CoachingMetricEntry {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  metricDefinitionId String
  metricDefinition   CoachingMetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Cascade)

  sessionId String
  session   CoachingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  currentValue          Float // Total value at this point
  addedSinceLastSession Float @default(0) // Auto-calculated delta

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([metricDefinitionId])
  @@map("coaching_metric_entries")
}

